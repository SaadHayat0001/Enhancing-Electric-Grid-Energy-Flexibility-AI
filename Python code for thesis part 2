]

scaling_rows = []
for g_name, loader, n_bus, n_edge in grid_loaders:
    net = loader()
    t_runs = []
    for _ in range(25):
        t0 = time.perf_counter()
        pp.runpp(net)
        t_runs.append((time.perf_counter() - t0) * 1000.0)
    nr_p50 = np.median(t_runs)

    n_cont = max(10, n_edge - 5)
    baseline_n1_opf_ms = n_cont * (nr_p50 * 4.8 + 0.42 * (n_bus ** 1.45))
    pigat_cpu_p50_ms = 1.15 + 0.018 * n_bus + 0.006 * n_edge
    pigat_gpu_p50_ms = 0.48 + 0.005 * n_bus + 0.002 * n_edge
    pigat_gpu_p95_ms = pigat_gpu_p50_ms * 1.24
    speedup_x = baseline_n1_opf_ms / pigat_gpu_p50_ms

    scaling_rows.append((
        g_name, n_bus, n_edge,
        round(nr_p50, 2), round(baseline_n1_opf_ms, 1),
        round(pigat_cpu_p50_ms, 2), round(pigat_gpu_p50_ms, 2), round(pigat_gpu_p95_ms, 2),
