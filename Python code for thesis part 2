grid_loaders = [
    ("IEEE 14-Bus", pn.case14, 14, 20),
    ("IEEE 33-Bus Feeder", pn.case33bw, 33, 37),
    ("IEEE 57-Bus", pn.case57, 57, 80),
    ("IEEE 118-Bus", pn.case118, 118, 186),
