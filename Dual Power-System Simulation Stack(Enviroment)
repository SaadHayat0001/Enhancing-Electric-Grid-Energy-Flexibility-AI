# ==============================================================================
# PhD Dissertation Reproducibility Environment (Appendix D)
# Title:     Enhancing Electric Grid Energy Flexibility using AI
# Candidate: Engr. Saad Hayat (336-GUELE-22) | Gomal University, D.I. Khan
#
# Dual Power-System Simulation Stack:
#   1. Python / pandapower 2.13.1 (Unified 3-Layer Closed-Loop AI + AC-OPF)
#      Install via: conda env create -f environment.yml && conda activate grid-flexibility-ai
#   2. MATLAB R2025a + MATPOWER 8.1 (Baseline & Cross-Validation Suite in /matpower)
#      Install in MATLAB via: install_matpower(1, 1); rng(42, 'twister');
# ==============================================================================

name: grid-flexibility-ai
channels:
  - pytorch
  - pyg
  - conda-forge
  - defaults
dependencies:
  - python=3.10.12
  - pip=23.3.1
  - numpy=1.24.4
  - pandas=2.1.3
  - scipy=1.11.4          # Includes scipy.io (loadmat/savemat) for MATLAB/MATPOWER data exchange
  - scikit-learn=1.3.2
  - matplotlib=3.8.2
  - pytorch=2.1.0
  - pyg=2.4.0
  - pip:
      - pandapower==2.13.1
      - xgboost==2.0.2
      - optuna==3.5.0
      - shap==0.44.0
      - statsmodels==0.14.0
      - prophet==1.1.5
      - openpyxl==3.1.2
      - h5py==3.10.0      # Reads/writes MATLAB v7.3 .mat files if needed
