assert set(PRE_DISPATCH_NODE_FEATURES + PRE_DISPATCH_EDGE_FEATURES).isdisjoint(set(FORBIDDEN_POST_PF_FEATURES)), "Data leakage detected!"
print("[C18 VERIFIED] Zero post-power-flow variables in X_t or E_t. Strict pre-dispatch causality enforced.")

# 2. Execute Real 11-Step Reactive Load Stress Ramp on IEEE 14-Bus in pandapower (C12)
ramp_multipliers = np.linspace(1.0, 2.5, 11)
ramp_rows = []
for mult in ramp_multipliers:
    net14 = pn.case14()
    net14.load["q_mvar"] *= mult
