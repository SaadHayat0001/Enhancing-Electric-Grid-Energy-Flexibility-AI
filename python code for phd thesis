PRE_DISPATCH_NODE_FEATURES = ["P_D_mw", "Q_D_mvar", "P_G_sched_mw", "V_set_pu", "bus_type_onehot"]
PRE_DISPATCH_EDGE_FEATURES = ["R_ij_pu", "X_ij_pu", "B_ij_pu", "X_over_R_ratio", "line_status_u_ij"]
